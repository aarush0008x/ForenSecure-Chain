APP_NAME=ForenSecure Chain
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Option A: provide a complete SQLAlchemy URL.
# DATABASE_URL=mysql+pymysql://root:your_password@localhost:3306/forensecure_chain?charset=utf8mb4

# Option B: let the application build the URL from these values.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=forensecure_chain

DATABASE_ECHO=false
STORAGE_DIR=storage
MAX_UPLOAD_SIZE=104857600
MAX_RECOVERY_INPUT_SIZE=536870912